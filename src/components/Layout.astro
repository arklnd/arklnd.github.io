---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  /** ISO date string — article published time */
  publishedTime?: string;
  /** ISO date string — article modified time */
  modifiedTime?: string;
  /** Article author name */
  author?: string;
  /** Article tags for article:tag OG meta */
  tags?: string[];
  /** Whether this page uses KaTeX math rendering */
  katex?: boolean;
  /** Hide nav and footer for immersive pages */
  bare?: boolean;
}

const {
  title,
  description = "A quiet place to read.",
  ogType = "website",
  ogImage,
  publishedTime,
  modifiedTime,
  author = "Arijit Kundu",
  tags = [],
  katex = false,
  bare = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} | Arijit's Blog | ArijitK.in` : "Arijit's Blog | ArijitK.in";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL.href} />
    {katex && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}

    <!-- PWA / Favicon -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}icon.svg`} sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon-180x180.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" content="#3d6aa8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1f26" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Arijit's Blog" />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <!-- Article-specific Open Graph -->
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && <meta property="article:author" content={author} />}
    {ogType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- JSON-LD -->
    <slot name="head" />

    <!-- Theme + width init — runs before first paint to prevent FOUC -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        if (stored === "dark" || stored === "light") {
          document.documentElement.dataset.theme = stored;
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.dataset.theme = "dark";
        } else {
          document.documentElement.dataset.theme = "light";
        }

        if (localStorage.getItem("wide") === "true") {
          document.documentElement.dataset.wide = "true";
        }

        if (localStorage.getItem("stickyScroll") === "off") {
          document.documentElement.dataset.stickyScroll = "off";
        }
      })();

      // Preserve data attributes across client-side navigations
      document.addEventListener("astro:before-swap", function (e) {
        var html = document.documentElement;
        var next = e.newDocument.documentElement;
        if (html.dataset.theme) next.dataset.theme = html.dataset.theme;
        if (html.dataset.wide) next.dataset.wide = html.dataset.wide;
        if (html.dataset.stickyScroll) next.dataset.stickyScroll = html.dataset.stickyScroll;
      });
    </script>

    {ga4Id && (
      <>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function gtag() { dataLayer.push(arguments); };
          if (!document.getElementById('gtag-js')) {
            var s = document.createElement('script');
            s.id = 'gtag-js';
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
            document.head.appendChild(s);
          }
          gtag('js', new Date());
          gtag('config', ga4Id, { send_page_view: false });
        </script>
        <script>
          document.addEventListener('astro:page-load', () => {
            (window as any).gtag?.('event', 'page_view', {
              page_title: document.title,
              page_location: window.location.href,
            });
          });
        </script>
      </>
    )}
    <ClientRouter />
    <link rel="alternate" type="application/rss+xml" title="Arijit's Blog" href={`${base}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;0,7..72,700;1,7..72,400;1,7..72,500&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navigation progress bar -->
    <div id="nav-progress" class="nav-progress" aria-hidden="true"></div>

    <!-- Skip to content link for keyboard users -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Full-page theme transition loader -->
    <div id="theme-loader" class="theme-loader" aria-hidden="true">
      <div class="theme-loader-spinner"></div>
    </div>

    <div class="page">
      <slot name="before-nav" />
      {!bare && <Nav />}
      <main id="main-content">
        <slot />
      </main>
      {!bare && <Footer />}
    </div>

    <!-- Navigation progress bar logic -->
    <script is:inline>
      (function () {
        var bar = document.getElementById('nav-progress');
        var timer = null;
        var width = 0;

        function setWidth(w) {
          width = w;
          bar.style.width = w + '%';
        }

        function start() {
          if (timer) clearInterval(timer);
          setWidth(0);
          bar.classList.add('nav-progress--active');
          // Tick toward 85% to fake progress
          timer = setInterval(function () {
            if (width < 85) setWidth(width + (85 - width) * 0.12);
          }, 100);
        }

        function finish() {
          if (timer) { clearInterval(timer); timer = null; }
          setWidth(100);
          setTimeout(function () {
            bar.classList.remove('nav-progress--active');
            setWidth(0);
          }, 300);
        }

        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:page-load', finish);
      })();
    </script>

    <!-- PWA: Service Worker registration with auto-reload on new build -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          var refreshing = false;

          // When a new SW takes control, reload to show fresh content
          navigator.serviceWorker.addEventListener("controllerchange", function () {
            if (refreshing) return;
            refreshing = true;
            window.location.reload();
          });

          navigator.serviceWorker.register("/sw.js", { scope: "/" }).then(function (reg) {
            // Check for updates periodically (every 60 minutes)
            setInterval(function () { reg.update(); }, 60 * 60 * 1000);

            // If a new SW is already waiting (e.g. user reopened tab), activate it
            if (reg.waiting) {
              reg.waiting.postMessage({ type: "SKIP_WAITING" });
            }

            // Detect when a new SW is installed and tell it to activate
            reg.addEventListener("updatefound", function () {
              var newSW = reg.installing;
              if (!newSW) return;
              newSW.addEventListener("statechange", function () {
                if (newSW.state === "installed" && navigator.serviceWorker.controller) {
                  // New content available — activate the new SW immediately
                  newSW.postMessage({ type: "SKIP_WAITING" });
                }
              });
            });
          });
        });
      }
    </script>

    <!-- Clean up will-change after entrance animations to free GPU layers -->
    <script is:inline>
      document.addEventListener("animationend", function (e) {
        var t = e.target;
        if (t && t.classList && (t.classList.contains("post-card") || t.classList.contains("article") || t.classList.contains("home-header"))) {
          t.classList.add("anim-done");
        }
      }, { passive: true });
    </script>

    <script>
      let mermaidModule: any = null;
      const originals = new Map<HTMLElement, string>();

      const EXPAND_ICON = `<svg width="11" height="11" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="1,3.5 1,1 3.5,1"/><polyline points="6.5,1 9,1 9,3.5"/><polyline points="9,6.5 9,9 6.5,9"/><polyline points="3.5,9 1,9 1,6.5"/></svg>`;

      // Attaches viewBox-based zoom+pan to svg within container. Returns control helpers.
      function attachSvgZoom(
        svg: SVGSVGElement,
        container: HTMLElement,
        origVX: number, origVY: number, origVW: number, origVH: number,
        ac: AbortController
      ) {
        let scale = 1, vpX = origVX, vpY = origVY;
        // Diagram aspect ratio is fixed; viewBox aspect = origVW/origVH at every zoom level.
        const diagAspect = origVW / origVH;

        function applyViewBox() {
          svg.setAttribute("viewBox", `${vpX} ${vpY} ${origVW / scale} ${origVH / scale}`);
        }

        // With preserveAspectRatio="xMidYMid meet" the SVG element may be larger than the
        // rendered content (letterboxing). Pixel↔SVG-unit conversion must use the content
        // pixel size, not the element's bounding rect, otherwise the axes scale differently.
        function contentSize(rect: DOMRect) {
          const elAspect = rect.width / rect.height;
          let cw: number, ch: number;
          if (diagAspect > elAspect) { cw = rect.width;  ch = rect.width  / diagAspect; }
          else                       { ch = rect.height; cw = rect.height * diagAspect; }
          // offsets of content top-left corner inside the element
          return { cw, ch, cxOff: (rect.width - cw) / 2, cyOff: (rect.height - ch) / 2 };
        }

        // pxX/pxY are element-relative (from getBoundingClientRect top-left).
        function zoomAt(newScale: number, pxX: number, pxY: number) {
          const rect = svg.getBoundingClientRect();
          const { cw, ch, cxOff, cyOff } = contentSize(rect);
          const vpW = origVW / scale, vpH = origVH / scale;
          const relX = pxX - cxOff, relY = pxY - cyOff;
          const svgX = vpX + (relX / cw) * vpW;
          const svgY = vpY + (relY / ch) * vpH;
          scale = Math.min(Math.max(newScale, 0.111), 18);
          vpX = svgX - (relX / cw) * (origVW / scale);
          vpY = svgY - (relY / ch) * (origVH / scale);
          applyViewBox();
        }

        container.style.cursor = "grab";

        // ── Momentum ────────────────────────────────────────────────────────
        // Track velocity in screen px/ms using an EMA so the last ~20 ms of
        // movement dominate.  On release we convert to SVG-unit/ms and run a
        // rAF loop that applies exponential friction until speed < threshold.
        let velPxX = 0, velPxY = 0;
        let lastMX = 0, lastMY = 0, lastMT = 0;
        let momentumRaf = 0;

        const FRICTION    = 0.963;  // velocity multiplier per 16 ms frame (0.952^(1/1.3) ≈ 30% longer glide)
        const MIN_PX_MS   = 0.05;  // stop when slower than this (px/ms ≈ 3 px/frame)

        function resetVelocity() {
          velPxX = 0; velPxY = 0; lastMT = 0;
          cancelAnimationFrame(momentumRaf);
          momentumRaf = 0;
        }

        function trackVelocity(clientX: number, clientY: number) {
          const now = performance.now();
          const dt  = now - lastMT;
          // Only use samples within an 80 ms window; ignore stale or zero-dt events
          if (lastMT > 0 && dt > 0 && dt < 80) {
            const alpha = Math.min(1, dt / 20);   // ~1 frame window
            velPxX = velPxX * (1 - alpha) + ((clientX - lastMX) / dt) * alpha;
            velPxY = velPxY * (1 - alpha) + ((clientY - lastMY) / dt) * alpha;
          }
          lastMX = clientX; lastMY = clientY; lastMT = now;
        }

        function startMomentum() {
          cancelAnimationFrame(momentumRaf);
          // If the pointer paused before release, kill velocity
          if (performance.now() - lastMT > 80) { velPxX = 0; velPxY = 0; }
          if (Math.hypot(velPxX, velPxY) < MIN_PX_MS) return;

          // Convert px/ms → SVG-unit/ms once, at the moment of release
          const rect = svg.getBoundingClientRect();
          const { cw, ch } = contentSize(rect);
          const vpW = origVW / scale, vpH = origVH / scale;
          // Negate: dragging right moves the viewBox origin left
          let mvX = -velPxX * (vpW / cw);
          let mvY = -velPxY * (vpH / ch);

          let lastT = 0;
          function frame(t: number) {
            const dt = lastT ? Math.min(t - lastT, 64) : 16;
            lastT = t;
            const f = FRICTION ** (dt / 16);   // frame-rate independent friction
            mvX *= f; mvY *= f;
            vpX += mvX * dt;
            vpY += mvY * dt;
            applyViewBox();
            // Convert back to px/ms for the stop threshold
            if (Math.hypot(mvX * (cw / vpW), mvY * (ch / vpH)) > MIN_PX_MS) {
              momentumRaf = requestAnimationFrame(frame);
            }
          }
          momentumRaf = requestAnimationFrame(frame);
        }

        // ── Mouse drag ──────────────────────────────────────────────────────
        let dragging = false, ox = 0, oy = 0, ovpX = 0, ovpY = 0;

        container.addEventListener("mousedown", (e) => {
          if ((e.target as HTMLElement).closest(".mermaid-zoom-ctrl")) return;
          resetVelocity();
          dragging = true;
          ox = e.clientX; oy = e.clientY; ovpX = vpX; ovpY = vpY;
          lastMX = e.clientX; lastMY = e.clientY; lastMT = performance.now();
          container.style.cursor = "grabbing";
          e.preventDefault();
        });

        window.addEventListener("mousemove", (e) => {
          if (!dragging) return;
          trackVelocity(e.clientX, e.clientY);
          const rect = svg.getBoundingClientRect();
          const { cw, ch } = contentSize(rect);
          const vpW = origVW / scale, vpH = origVH / scale;
          vpX = ovpX - ((e.clientX - ox) / cw) * vpW;
          vpY = ovpY - ((e.clientY - oy) / ch) * vpH;
          applyViewBox();
        }, { signal: ac.signal });

        window.addEventListener("mouseup", () => {
          if (!dragging) return;
          dragging = false;
          container.style.cursor = "grab";
          startMomentum();
        }, { signal: ac.signal });

        container.addEventListener("wheel", (e) => {
          e.preventDefault();
          cancelAnimationFrame(momentumRaf); // wheel cancels any ongoing glide
          const rect = svg.getBoundingClientRect();
          zoomAt(scale * (e.deltaY < 0 ? 1.1 : 0.9), e.clientX - rect.left, e.clientY - rect.top);
        }, { passive: false });

        // ── Touch ───────────────────────────────────────────────────────────
        // Prevent the browser from handling touch gestures (pan/pinch-zoom) on
        // this element so our non-passive handlers can call preventDefault.
        container.style.touchAction = "none";

        let t0: Touch | null = null, ovpX0 = 0, ovpY0 = 0;
        let pinchDist0 = 0, pinchScale0 = 1, pinchMidX0 = 0, pinchMidY0 = 0;

        container.addEventListener("touchstart", (e) => {
          // Let button taps pass through so the browser synthesises a click event.
          if ((e.target as HTMLElement).closest(".mermaid-zoom-ctrl")) return;
          e.preventDefault();
          cancelAnimationFrame(momentumRaf);
          if (e.touches.length === 1) {
            t0 = e.touches[0];
            ovpX0 = vpX; ovpY0 = vpY;
            pinchDist0 = 0;
            velPxX = 0; velPxY = 0;
            lastMX = t0.clientX; lastMY = t0.clientY; lastMT = performance.now();
          } else if (e.touches.length === 2) {
            t0 = null; // suspend single-finger pan while pinching
            resetVelocity();
            const a = e.touches[0], b = e.touches[1];
            pinchDist0  = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
            pinchScale0 = scale;
            pinchMidX0  = (a.clientX + b.clientX) / 2;
            pinchMidY0  = (a.clientY + b.clientY) / 2;
          }
        }, { passive: false });

        container.addEventListener("touchmove", (e) => {
          e.preventDefault();
          if (e.touches.length === 1 && t0) {
            const touch = e.touches[0];
            trackVelocity(touch.clientX, touch.clientY);
            const rect = svg.getBoundingClientRect();
            const { cw, ch } = contentSize(rect);
            const vpW = origVW / scale, vpH = origVH / scale;
            vpX = ovpX0 - ((touch.clientX - t0.clientX) / cw) * vpW;
            vpY = ovpY0 - ((touch.clientY - t0.clientY) / ch) * vpH;
            applyViewBox();
          } else if (e.touches.length === 2 && pinchDist0 > 0) {
            const a = e.touches[0], b = e.touches[1];
            const dist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
            const midX = (a.clientX + b.clientX) / 2;
            const midY = (a.clientY + b.clientY) / 2;
            const rect = svg.getBoundingClientRect();
            zoomAt(pinchScale0 * (dist / pinchDist0), midX - rect.left, midY - rect.top);
          }
        }, { passive: false });

        container.addEventListener("touchend", (e) => {
          if (e.touches.length === 1) {
            // One finger lifted (e.g. from pinch) — restart single-finger pan
            resetVelocity();
            t0 = e.touches[0];
            ovpX0 = vpX; ovpY0 = vpY;
            pinchDist0 = 0;
            lastMX = t0.clientX; lastMY = t0.clientY; lastMT = performance.now();
          } else if (e.touches.length === 0) {
            if (t0 && pinchDist0 === 0) {
              // Lifted from a single-finger pan — launch momentum
              startMomentum();
            } else {
              resetVelocity(); // lifted from pinch — no momentum
            }
            t0 = null;
            pinchDist0 = 0;
          }
        }, { passive: false });

        return {
          zoomIn(cx: number, cy: number)  { cancelAnimationFrame(momentumRaf); zoomAt(scale * 1.3, cx, cy); },
          zoomOut(cx: number, cy: number) { cancelAnimationFrame(momentumRaf); zoomAt(scale / 1.3, cx, cy); },
          reset()                         { resetVelocity(); scale = 1; vpX = origVX; vpY = origVY; applyViewBox(); }
        };
      }

      function openMermaidDialog(
        origSvg: SVGSVGElement,
        origVX: number, origVY: number, origVW: number, origVH: number
      ) {
        const dialog = document.createElement("dialog");
        dialog.className = "mermaid-dialog";

        const hdr = document.createElement("div");
        hdr.className = "mermaid-dialog-hdr";
        const closeBtn = document.createElement("button");
        closeBtn.className = "mermaid-dialog-close";
        closeBtn.setAttribute("aria-label", "Close");
        closeBtn.innerHTML = "&times;";
        hdr.appendChild(closeBtn);

        const body = document.createElement("div");
        body.className = "mermaid-dialog-body";

        const wrap = document.createElement("div");
        wrap.className = "mermaid-dialog-wrap";

        const svgClone = origSvg.cloneNode(true) as SVGSVGElement;
        svgClone.setAttribute("viewBox", `${origVX} ${origVY} ${origVW} ${origVH}`);
        // Strip Mermaid's inline style (e.g. max-width, width) so CSS can control sizing
        svgClone.removeAttribute("style");
        svgClone.setAttribute("width", "100%");
        svgClone.setAttribute("height", "100%");
        // preserveAspectRatio default "xMidYMid meet" keeps diagram fully visible and centered

        const ctrl = document.createElement("div");
        ctrl.className = "mermaid-zoom-ctrl";
        ctrl.innerHTML =
          `<button data-a="in" title="Zoom in" aria-label="Zoom in">+</button>` +
          `<button data-a="reset" title="Reset zoom" aria-label="Reset zoom">⊙</button>` +
          `<button data-a="out" title="Zoom out" aria-label="Zoom out">−</button>`;

        wrap.appendChild(svgClone);
        wrap.appendChild(ctrl);
        body.appendChild(wrap);
        dialog.appendChild(hdr);
        dialog.appendChild(body);
        document.body.appendChild(dialog);
        dialog.showModal();

        const ac = new AbortController();
        const { zoomIn, zoomOut, reset } = attachSvgZoom(svgClone, wrap, origVX, origVY, origVW, origVH, ac);

        ctrl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-a]");
          if (!btn) return;
          const rect = svgClone.getBoundingClientRect();
          const cx = rect.width / 2, cy = rect.height / 2;
          const a = btn.dataset.a;
          if (a === "in") zoomIn(cx, cy);
          else if (a === "out") zoomOut(cx, cy);
          else reset();
        });

        dialog.addEventListener("close", () => { ac.abort(); dialog.remove(); });
        closeBtn.addEventListener("click", () => dialog.close());
        // Close on backdrop click
        dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
      }

      function initMermaidZoom(el: HTMLElement) {
        const maybeSvg = el.querySelector<SVGSVGElement>("svg");
        if (!maybeSvg) return;
        const svg: SVGSVGElement = maybeSvg;

        // Resolve viewBox — passed to openMermaidDialog so dialog zoom/drag has correct origin
        const raw = svg.getAttribute("viewBox");
        const parts = raw ? raw.trim().split(/[\s,]+/).map(Number) : [];
        const origVX = parts[0] ?? 0;
        const origVY = parts[1] ?? 0;
        const origVW = parts[2] ?? parseFloat(svg.getAttribute("width") ?? "800");
        const origVH = parts[3] ?? parseFloat(svg.getAttribute("height") ?? "600");
        if (!raw) svg.setAttribute("viewBox", `${origVX} ${origVY} ${origVW} ${origVH}`);

        // Inline view: only a fullscreen button — zoom/drag available inside the dialog
        const ctrl = document.createElement("div");
        ctrl.className = "mermaid-zoom-ctrl";
        ctrl.innerHTML =
          `<button data-a="full" title="Open fullscreen" aria-label="Open fullscreen">${EXPAND_ICON}</button>`;
        el.appendChild(ctrl);

        ctrl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-a]");
          if (btn?.dataset.a === "full") openMermaidDialog(svg, origVX, origVY, origVW, origVH);
        });
      }

      async function renderMermaid() {
        const diagrams = document.querySelectorAll<HTMLElement>(".mermaid");
        if (!diagrams.length) return;

        // Store original text on first run
        diagrams.forEach((el) => {
          if (!originals.has(el)) originals.set(el, el.innerHTML || "");
        });

        // Show loading state immediately
        diagrams.forEach((el) => el.classList.add("mermaid-loading"));

        // Yield to let the browser paint the loading state
        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

        if (!mermaidModule) {
          // @ts-ignore — runtime CDN import, no type declarations available
          mermaidModule = (await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs")).default;
        }
        const mermaid = mermaidModule;
        const isDark = document.documentElement.dataset.theme === "dark";

        // Restore original markup before re-rendering
        diagrams.forEach((el) => {
          const src = originals.get(el);
          if (src) {
            el.innerHTML = src;
            el.removeAttribute("data-processed");
          }
        });

        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? "dark" : "base",
          fontFamily: "var(--font-body)",
          flowchart: {
            wrappingWidth: 300,
          },
          themeVariables: isDark
            ? {}
            : {
                primaryColor: "#dce0e5",
                primaryTextColor: "#303840",
                primaryBorderColor: "#525d68",
                lineColor: "#525d68",
                secondaryColor: "#edf0f3",
                tertiaryColor: "#f5f6f8",
                textColor: "#303840",
                nodeTextColor: "#303840",
                mainBkg: "#dce0e5",
                nodeBorder: "#525d68",
                clusterBkg: "#edf0f3",
                clusterBorder: "#c5cad2",
                edgeLabelBackground: "#edf0f3",
                fontFamily: "var(--font-body)",
                git0: "#3d6aa8",
                git1: "#d45d00",
                git2: "#2a8c6a",
                git3: "#8b5cc4",
                git4: "#c4483e",
                git5: "#0d7d8c",
                git6: "#7a6b30",
                git7: "#b04d8c",
                gitBranchLabel0: "#ffffff",
                gitBranchLabel1: "#ffffff",
                gitBranchLabel2: "#ffffff",
                gitBranchLabel3: "#ffffff",
                gitBranchLabel4: "#ffffff",
                gitBranchLabel5: "#ffffff",
                gitBranchLabel6: "#ffffff",
                gitBranchLabel7: "#ffffff",
                gitInv0: "#ffffff",
                gitInv1: "#ffffff",
                gitInv2: "#ffffff",
                gitInv3: "#ffffff",
                gitInv4: "#ffffff",
                gitInv5: "#ffffff",
                gitInv6: "#ffffff",
                gitInv7: "#ffffff",
                tagLabelColor: "#303840",
                tagLabelBackground: "#dce0e5",
                tagLabelBorder: "#525d68",
                commitLabelColor: "#303840",
                commitLabelBackground: "#edf0f3",
              },
        });
        await mermaid.run({ nodes: diagrams });

        // Make rendered SVGs accessible
        diagrams.forEach((el) => {
          const svg = el.querySelector("svg");
          if (svg) {
            svg.setAttribute("role", "img");
            svg.setAttribute("aria-label", "Diagram");
          }
        });

        // Remove loading state
        diagrams.forEach((el) => el.classList.remove("mermaid-loading"));

        // Enable zoom/pan on each rendered diagram
        diagrams.forEach((el) => initMermaidZoom(el));
      }

      // Initial render
      renderMermaid();

      // Re-render on theme toggle
      const observer = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.attributeName === "data-theme") {
            renderMermaid();
            break;
          }
        }
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    </script>
  </body>
</html>

