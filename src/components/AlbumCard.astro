---
import type { Album, GalleryPhoto } from "../data/photos";

interface Props {
  album: Album;
  coverPhoto: GalleryPhoto | undefined;
}

const { album, coverPhoto } = Astro.props;

const isDev = import.meta.env.DEV || import.meta.env.PUBLIC_LOCAL_DEV === "true";
const href = `${import.meta.env.BASE_URL}photo-albums/${album.slug}`;

const formattedDate = album.date
  ? new Date(album.date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
---

<li class="pc pc--grid ac">
  <a href={href} aria-label={album.title} class="pc-link">
    {coverPhoto && (
      <div class="ac-cover">
        <img
          src={isDev
            ? `${import.meta.env.BASE_URL}images/gallery/${coverPhoto.filename}`
            : `${import.meta.env.BASE_URL}images/gallery/thumbs/${coverPhoto.filename}.webp`}
          alt={coverPhoto.alt ?? coverPhoto.caption ?? album.title}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <div class="ac-body">
      <span class="ac-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
        Photo Album
      </span>
      <span class="ac-title">{album.title}</span>
      {album.description && (
        <span class="ac-desc">{album.description.split("\n")[0]}</span>
      )}
    </div>
    <div class="ac-footer">
      <span class="ac-meta">
        {formattedDate && <time datetime={album.date!}>{formattedDate}</time>}
        {formattedDate && <> &mdash; </>}
        {album.photoSlugs.length} photo{album.photoSlugs.length !== 1 ? "s" : ""}
        {album.location && <> &mdash; {album.location}</>}
      </span>
    </div>
  </a>
</li>

<style>
  /* Album card — own layout, does not reuse pc-body / pc-footer */
  .ac .pc-link {
    padding: 0;
    overflow: hidden;
  }

  .ac-cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
  }

  .ac-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .ac:hover .ac-cover img {
    transform: scale(1.04);
  }

  .ac-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md) var(--space-xs);
  }

  .ac-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .ac-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .ac:hover .ac-title {
    color: var(--color-link);
  }

  .ac-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ac-footer {
    display: flex;
    align-items: center;
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
    margin: 0 var(--space-md);
  }

  .ac-meta {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.01em;
  }
</style>
