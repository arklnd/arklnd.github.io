---
/**
 * PlaceLink — inline decorated link to Google Maps.
 *
 * Google Maps URL is auto-constructed from name + state + country.
 * Pass state="HIDE" or country="HIDE" to suppress that part from
 * the visible text and the URL.
 *
 * The `gmap` prop is an optional override:
 *   omitted            → auto-construct URL from name + state + country
 *   gmap="https://…"   → use this URL instead of the auto-constructed one
 *   gmap="HIDE"        → render as plain styled text, no link at all
 *
 * Examples:
 *   <PlaceLink name="Kolkata" />
 *   → 📍 Kolkata, West Bengal   (auto URL, WB default)
 *
 *   <PlaceLink name="Anini" state="Arunachal Pradesh" gmap="https://maps.app.goo.gl/pcS1ioGvEHsQsh39A" />
 *   → 📍 Anini, Arunachal Pradesh   (custom short link used)
 *
 *   <PlaceLink name="some note" state="HIDE" country="HIDE" gmap="HIDE" />
 *   → 📍 some note   (no state, no link)
 */
interface Props {
  name:     string;
  state?:   string;  // default "West Bengal";  "HIDE" = omit from text + URL
  country?: string;  // default "India";        "HIDE" = omit from URL + tooltip
  gmap?:    string;  // override URL | "HIDE" (no link) | omit (auto-construct)
}
const {
  name,
  state   = 'West Bengal',
  country = 'India',
  gmap,
} = Astro.props;

const showState   = state   !== 'HIDE';
const showCountry = country !== 'HIDE';

// Determine href
let href: string | null;
if (gmap === 'HIDE') {
  href = null;                   // plain text, no link
} else if (gmap) {
  href = gmap;                   // caller-supplied URL takes precedence
} else {
  // auto-construct Google Maps search URL
  const parts: string[] = [name];
  if (showState)   parts.push(state);
  if (showCountry) parts.push(country);
  href = 'https://maps.google.com/?q=' + encodeURIComponent(parts.join(', '));
}

// Tooltip — plain string concat, no template-literal edge-cases
const tipParts: string[] = [name];
if (showState)   tipParts.push(state);
if (showCountry) tipParts.push(country);
const tooltip = '\uD83D\uDCCD ' + tipParts.join(', ') + ' \u2014 Open in Google Maps';
---

{href ? (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    title={tooltip}
    class="place-link"
  ><span class="pin" aria-hidden="true">📍</span
  ><span class="pname">{name}</span
  >{showState && <span class="pstate">, {state}</span>}
  </a>
) : (
  <span
    class="place-link place-nomap"
    title={'\uD83D\uDCCD ' + name}
  ><span class="pin" aria-hidden="true">📍</span
  ><span class="pname">{name}</span
  >{showState && <span class="pstate">, {state}</span>}
  </span>
)}

<style>
  .place-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    color: var(--color-link);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.14s ease;
  }

  a.place-link:hover,
  a.place-link:focus-visible {
    opacity: 0.82;
    outline: none;
  }

  a.place-link:focus-visible {
    outline:       2px solid var(--color-link);
    outline-offset: 2px;
  }

  /* non-linked variant — no pointer */
  .place-nomap {
    cursor: default;
    opacity: 0.72;
  }

  .pin {
    font-size:    0.72em;
    line-height:  1.5;
    flex-shrink:  0;
    opacity:      0.7;
    margin-right: 0.18em;
  }

  .pname {
    line-height: inherit;
  }

  /* state label — slightly muted so the place name stays primary */
  .pstate {
    font-size: 0.88em;
    opacity:   0.72;
  }
</style>
