---
/**
 * PlaceLink — inline decorated link to Google Maps.
 *
 * The URL is constructed internally from name + state + country.
 * Pass state="HIDE" or country="HIDE" to suppress that part from
 * both the visible text and the URL.
 *
 * Usage:
 *   <PlaceLink name="Kolkata" />
 *   → 📍 Kolkata, West Bengal  (state defaults to "West Bengal")
 *
 *   <PlaceLink name="Tawang" state="Arunachal Pradesh" />
 *   → 📍 Tawang, Arunachal Pradesh
 *
 *   <PlaceLink name="Sela Pass" state="Arunachal Pradesh" country="HIDE" />
 *   → 📍 Sela Pass, Arunachal Pradesh  (India excluded from URL too)
 *
 *   <PlaceLink name="some note" state="HIDE" country="HIDE" gmap={false} />
 *   → 📍 some note  (no link, no state, no country)
 *
 * Props:
 *   name     — display text (required)
 *   state    — appended after name;  default "West Bengal";  "HIDE" = omit
 *   country  — used in URL + tooltip; default "India";       "HIDE" = omit
 *   gmap     — render as a link? default true
 */
interface Props {
  name:     string;
  state?:   string;   // default: "West Bengal"
  country?: string;   // default: "India"
  gmap?:    boolean;  // default: true
}
const {
  name,
  state   = 'West Bengal',
  country = 'India',
  gmap    = true,
} = Astro.props;

const showState   = state   !== 'HIDE';
const showCountry = country !== 'HIDE';

// Google Maps URL
const queryParts: string[] = [name];
if (showState)   queryParts.push(state);
if (showCountry) queryParts.push(country);
const mapsUrl = 'https://maps.google.com/?q=' + encodeURIComponent(queryParts.join(', '));

// Tooltip — plain concatenation, no template-literal edge-cases
const tipParts: string[] = [name];
if (showState)   tipParts.push(state);
if (showCountry) tipParts.push(country);
const tooltip = '\uD83D\uDCCD ' + tipParts.join(', ') + ' \u2014 Open in Google Maps';
---

{gmap ? (
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    title={tooltip}
    class="place-link"
  >
    <span class="pin" aria-hidden="true">📍</span
    ><span class="pname">{name}</span
    >{showState && <span class="pstate">, {state}</span>}
  </a>
) : (
  <span class="place-link place-nomap" title={'\uD83D\uDCCD ' + name}>
    <span class="pin" aria-hidden="true">📍</span
    ><span class="pname">{name}</span
    >{showState && <span class="pstate">, {state}</span>}
  </span>
)}

<style>
  /* Visually distinct from regular prose links (solid underline → dashed here) */
  .place-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1.5px dashed;
    border-bottom-color: color-mix(in srgb, var(--color-link) 40%, transparent);
    padding-bottom: 1px;
    white-space: nowrap;
    transition:
      border-bottom-color 0.14s ease,
      border-bottom-style 0.14s ease,
      opacity            0.14s ease;
  }

  a.place-link:hover,
  a.place-link:focus-visible {
    border-bottom-style:  solid;
    border-bottom-color:  var(--color-link);
    opacity: 0.82;
    outline: none;
  }

  a.place-link:focus-visible {
    outline:       2px solid var(--color-link);
    outline-offset: 2px;
    border-bottom: none;
  }

  /* non-linked variant */
  .place-nomap {
    cursor: default;
    border-bottom-style: dotted;
    opacity: 0.72;
  }

  .pin {
    font-size:   0.72em;
    line-height: 1.5;
    flex-shrink: 0;
    opacity:     0.7;
    margin-right: 0.18em;
  }

  .pname {
    line-height: inherit;
  }

  /* state label — slightly muted so the place name stays primary */
  .pstate {
    font-size: 0.88em;
    opacity:   0.72;
  }
</style>
